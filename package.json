{
  "name": "examlens",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
